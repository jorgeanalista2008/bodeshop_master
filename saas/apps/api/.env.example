# Variable de Switch de Entorno
DEPLOYMENT_ENV="local" # 'local' | 'production'

# Local
LOCAL_DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/bodeshop_saas?schema=public"
LOCAL_DIRECT_URL="postgresql://postgres:password@127.0.0.1:5432/bodeshop_saas?schema=public"
LOCAL_API_URL="http://localhost:4000"
LOCAL_WEB_URL="http://localhost:3000"

# Producción (Supabase)
PROD_DATABASE_URL="postgresql://postgres.[REF]:[PASS]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
PROD_DIRECT_URL="postgresql://postgres.[REF]:[PASS]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
PROD_API_URL="https://api.tudominio.com"
PROD_WEB_URL="https://tudominio.com"

# Cadena Activa
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/bodeshop_saas?schema=public"
DIRECT_URL="postgresql://postgres:password@127.0.0.1:5432/bodeshop_saas?schema=public"

PORT=4000
JWT_SECRET="cambiar-en-produccion"
JWT_EXPIRES_IN="15m"
